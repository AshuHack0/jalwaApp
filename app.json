{
  "expo": {
    "name": "71club",
    "slug": "71club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcon.png",
    "scheme": "71club",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ashutosh_sehgal_nit.club71"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1117",
        "foregroundImage": "./assets/appIcon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ashutosh_sehgal_nit.club71"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/appIcon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1117",
          "dark": {
            "backgroundColor": "#0f1117"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GillSans-Bold.ttf",
            "./assets/fonts/GillSans-Heavy.ttf",
            "./assets/fonts/GillSans-Medium.ttf",
            "./assets/fonts/GillSans-Light.ttf",
            "./assets/fonts/GillSans.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6193b984-ee91-46fe-b173-89c580500f58"
      }
    }
  }
}
